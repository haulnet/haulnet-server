[Unit]
Description=Haulnet server (LuxonServer for R.E.P.O.)
Documentation=https://github.com/haulnet/haulnet-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/haulnet-server/haulnet-server.env
ExecStart=/opt/haulnet-server/haulnetd
# haulnetd writes LuxonServer's config.yml into $STATE_DIRECTORY.
StateDirectory=haulnet-server
WorkingDirectory=%S/haulnet-server
DynamicUser=yes
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
