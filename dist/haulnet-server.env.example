# Haulnet server settings (KEY=VALUE, read by Docker, systemd and start.bat).

# Required: the public IP address or DNS name players use to reach this server (no port, no scheme).
EXTERNAL_ADDRESS=

# Name shown in the status endpoint and logs.
SERVER_NAME=haulnet-server

# Soft limits published in the status endpoint. Haulnet does not start new games on a server at its limit.
# 0 = not set. Size them from bandwidth: roughly 2-4 Mbit/s outgoing per 6-player room.
MAX_ROOMS=0
MAX_PLAYERS=0

# Hard limit of connections LuxonServer accepts (each player uses about two: game and voice).
MAX_CONNECTIONS=600

# Status endpoint (TCP). Publishes room/player counts and versions only.
STATUS_ADDRESS=:27080

# Log aggregate load (rooms, players, kbit/s, CPU) every interval, e.g. 60s. 0 = off.
STATS_LOG_INTERVAL=0

# haulnet-update (Docker): update only within these hours, server local time, e.g. 03:00-07:00. Empty = any time
# the server is empty. Automatic updates are switched on with: sudo ./haulnet-update enable
UPDATE_WINDOW=
# haulnet-update: while games run, the server takes no new games and waits for them to end. After this long
# (e.g. 3h, 30m) the update is installed anyway and remaining players are disconnected. Empty = wait forever.
UPDATE_FORCE_AFTER=
